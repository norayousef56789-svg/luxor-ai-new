np# Copy this file to `.env` and fill in the values.
# Client-side (exposed to the browser, safe to share — publishable keys only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side (used by server functions / SSR — never prefixed with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-ref
# Only needed for privileged server-side operations (business registration, admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI features ("Ask Luxor AI" + AI Marketing Studio) call the Lovable AI Gateway.
# Provide a key here, or swap the provider in src/lib/ai-gateway.server.ts for your own.
LOVABLE_API_KEY=your-lovable-ai-gateway-key
